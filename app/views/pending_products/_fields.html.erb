<% if pending_product.errors.any? %>
  <div class="rounded border border-accent bg-surface-2 px-4 py-3 text-sm text-text">
    <p class="font-semibold"><%= t(".errors_summary", count: pending_product.errors.count) %></p>
    <ul class="list-disc pl-5">
      <% pending_product.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="flex flex-col gap-1">
  <%= form.label :client_id, t(".client_label"), class: "text-sm font-medium text-text" %>
  <%= form.combobox :client_id, client_options_pending_products_path do |c|
    c.customize_input class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                               focus:outline-none focus:ring-2 focus:ring-accent"
  end %>
</div>

<div class="flex flex-col gap-1">
  <%= form.label :product_id, t(".product_label"), class: "text-sm font-medium text-text" %>
  <%= form.select :product_id,
        options_from_collection_for_select(Product.order(:name), :id, :name, pending_product.product_id),
        { include_blank: t(".product_placeholder") },
        { class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                   focus:outline-none focus:ring-2 focus:ring-accent" } %>
</div>

<div class="flex flex-col gap-1">
  <%= form.label :quantity, t(".quantity_label"), class: "text-sm font-medium text-text" %>
  <%= form.number_field :quantity, min: 1,
        class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                 focus:outline-none focus:ring-2 focus:ring-accent" %>
</div>
