<% content_for :title, t(".title") %>

<div class="flex w-full flex-col gap-8">
  <h1 class="text-2xl font-semibold text-text"><%= t(".title") %></h1>

  <%= form_with url: generate_daily_product_orders_path, method: :post, class: "flex items-end gap-3" do %>
    <div class="flex flex-col gap-1">
      <label class="text-sm font-medium text-text" for="zone_id"><%= t(".zone_label") %></label>
      <select name="zone_id" id="zone_id"
              class="h-11 rounded border border-border bg-surface px-3 text-sm text-text
                     focus:outline-none focus:ring-2 focus:ring-accent">
        <option value=""><%= t(".zone_placeholder") %></option>
        <% @zones.each do |zone| %>
          <option value="<%= zone.id %>"><%= zone.name %></option>
        <% end %>
      </select>
    </div>
    <button type="submit"
            class="h-11 rounded border-0 bg-accent px-5 text-sm font-semibold text-accent-contrast cursor-pointer">
      <%= t(".generate_button") %>
    </button>
  <% end %>

  <div class="overflow-x-auto rounded border border-border bg-surface">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-border text-text-muted">
          <th class="px-4 py-3 font-medium"><%= t(".table_day") %></th>
          <th class="px-4 py-3 font-medium"><%= t(".table_zone") %></th>
          <th class="px-4 py-3 font-medium"><%= t(".table_actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @batches.empty? %>
          <tr>
            <td class="px-4 py-3 text-text-muted" colspan="3"><%= t(".no_batches") %></td>
          </tr>
        <% end %>
        <% @batches.each do |batch| %>
          <tr class="border-b border-border last:border-0">
            <td class="px-4 py-3 text-text"><%= batch[:day].strftime("%d/%m/%Y") %></td>
            <td class="px-4 py-3 text-text"><%= batch[:zone].name %></td>
            <td class="px-4 py-3">
              <%= link_to t(".download_button"),
                    consolidated_daily_product_orders_path(zone_id: batch[:zone].id, day: batch[:day].iso8601),
                    class: "rounded border border-border px-3 py-1.5 text-text", data: { turbo: false } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
