<%= form_with model: product, class: "flex flex-col gap-4 max-w-sm" do |form| %>
  <% if product.errors.any? %>
    <div class="rounded border border-accent bg-surface-2 px-4 py-3 text-sm text-text">
      <p class="font-semibold"><%= t(".errors_summary", count: product.errors.count) %></p>
      <ul class="list-disc pl-5">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-1">
    <%= form.label :name, t(".name_label"), class: "text-sm font-medium text-text" %>
    <%= form.text_field :name,
          class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                   focus:outline-none focus:ring-2 focus:ring-accent" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :price, t(".price_label"), class: "text-sm font-medium text-text" %>
    <%= form.number_field :price, min: 0, step: 1,
          class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                   focus:outline-none focus:ring-2 focus:ring-accent" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t(".cancel"), products_path,
          class: "flex h-11 items-center rounded border border-border px-5 text-sm font-semibold text-text" %>
    <%= form.submit(product.persisted? ? t(".submit_update") : t(".submit_create"),
          class: "h-11 rounded border-0 bg-accent px-5 text-sm font-semibold text-accent-contrast cursor-pointer") %>
  </div>
<% end %>
