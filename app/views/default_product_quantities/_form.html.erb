<%= form_with model: default_product_quantity, class: "flex flex-col gap-4 max-w-md",
      data: { controller: "client-zone-filter" } do |form| %>
  <% if default_product_quantity.errors.any? %>
    <div class="rounded border border-accent bg-surface-2 px-4 py-3 text-sm text-text">
      <p class="font-semibold"><%= t(".errors_summary", count: default_product_quantity.errors.count) %></p>
      <ul class="list-disc pl-5">
        <% default_product_quantity.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-1">
    <%= form.label :zone_id, t(".zone_label"), class: "text-sm font-medium text-text" %>
    <%= form.select :zone_id,
          options_from_collection_for_select(Zone.order(:name), :id, :name, default_product_quantity.zone_id),
          { include_blank: t(".zone_placeholder") },
          { data: { action: "change->client-zone-filter#reload" },
            class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                     focus:outline-none focus:ring-2 focus:ring-accent" } %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :client_id, t(".client_label"), class: "text-sm font-medium text-text" %>
    <%= turbo_frame_tag "client_combobox", data: { client_zone_filter_target: "frame" } do %>
      <%= form.combobox :client_id,
            client_options_default_product_quantities_path(zone_id: default_product_quantity.zone_id) do |c|
        c.customize_input class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                                   focus:outline-none focus:ring-2 focus:ring-accent"
      end %>
    <% end %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :product_id, t(".product_label"), class: "text-sm font-medium text-text" %>
    <%= form.select :product_id,
          options_from_collection_for_select(Product.order(:name), :id, :name, default_product_quantity.product_id),
          { include_blank: t(".product_placeholder") },
          { class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                     focus:outline-none focus:ring-2 focus:ring-accent" } %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :quantity, t(".quantity_label"), class: "text-sm font-medium text-text" %>
    <%= form.number_field :quantity, min: 0,
          class: "h-11 rounded border border-border bg-surface px-3 text-sm text-text
                   focus:outline-none focus:ring-2 focus:ring-accent" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t(".cancel"), default_product_quantities_path,
          class: "flex h-11 items-center rounded border border-border px-5 text-sm font-semibold text-text" %>
    <%= form.submit(default_product_quantity.persisted? ? t(".submit_update") : t(".submit_create"),
          class: "h-11 rounded border-0 bg-accent px-5 text-sm font-semibold text-accent-contrast cursor-pointer") %>
  </div>
<% end %>
