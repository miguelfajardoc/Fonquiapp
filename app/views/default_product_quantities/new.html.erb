<% content_for :title, t(".title") %>

<div class="flex w-full flex-col gap-8" data-controller="modal edit-modal">
  <h1 class="text-2xl font-semibold text-text"><%= t(".title") %></h1>

  <div class="flex flex-col gap-8" data-controller="client-panel-filter" data-client-panel-filter-param-value="route_id">
    <%= render "form", default_product_quantity: @default_product_quantity, zone_id: @zone_id %>

    <%= turbo_frame_tag "default_product_quantity_route_panel", class: "block",
          data: { client_panel_filter_target: "frame" } do %>
      <%= render "route_panel", selected_route: @selected_route, route_defaults: @route_defaults %>
    <% end %>
  </div>

  <%= render "shared/confirm_dialog" %>
  <%= render "shared/edit_modal", frame_id: "default_product_quantity_edit_modal" %>
</div>
