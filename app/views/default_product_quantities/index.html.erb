<% content_for :title, t(".title") %>

<div class="flex w-full flex-col gap-6" data-controller="modal">
  <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
    <%= form_with url: default_product_quantities_path, method: :get, class: "flex flex-wrap items-end gap-3",
          data: { controller: "auto-submit", turbo_frame: "default_product_quantities" } do %>
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-text" for="client_name"><%= t(".filter_client_label") %></label>
        <input type="search" name="client_name" id="client_name" value="<%= @filters[:client_name] %>"
               placeholder="<%= t(".filter_client_placeholder") %>" autocomplete="off"
               data-action="input->auto-submit#debouncedSubmit" class="<%= filter_control_class %>">
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-text" for="zone_id"><%= t("shared.filters.zone_label") %></label>
        <select name="zone_id" id="zone_id" data-action="change->auto-submit#submit" class="<%= filter_control_class %>">
          <option value=""><%= t("shared.filters.all_zones") %></option>
          <% @zones.each do |zone| %>
            <option value="<%= zone.id %>" <%= "selected" if zone.id.to_s == @filters[:zone_id] %>><%= zone.name %></option>
          <% end %>
        </select>
      </div>
      <%= render "shared/clear_filters", path: default_product_quantities_path %>
    <% end %>

    <%= link_to t(".new_button"), new_default_product_quantity_path, class: create_button_class %>
  </div>

  <%= turbo_frame_tag "default_product_quantities", class: "flex flex-col gap-6", data: { turbo_action: "advance" } do %>
    <div class="overflow-x-auto rounded border border-border bg-surface">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-border text-text-muted">
            <th class="px-4 py-3 font-medium"><%= t(".table_client") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_zone") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_product") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_quantity") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @default_product_quantities.empty? %>
            <tr>
              <td class="px-4 py-3 text-text-muted" colspan="5"><%= t(".no_results") %></td>
            </tr>
          <% end %>
          <% @default_product_quantities.each do |default_product_quantity| %>
            <tr class="border-b border-border last:border-0">
              <td class="px-4 py-3 text-text"><%= default_product_quantity.client.name %></td>
              <td class="px-4 py-3 text-text"><%= default_product_quantity.zone.name %></td>
              <td class="px-4 py-3 text-text"><%= default_product_quantity.product.name %></td>
              <td class="px-4 py-3 text-text"><%= default_product_quantity.quantity %></td>
              <td class="px-4 py-3">
                <div class="flex gap-3">
                  <%= link_to t(".edit"), edit_default_product_quantity_path(default_product_quantity),
                        class: "rounded border border-border px-3 py-1.5 text-text" %>
                  <button type="button"
                          class="rounded border border-border px-3 py-1.5 text-text"
                          data-action="modal#open"
                          data-modal-name-param="<%= "#{default_product_quantity.client.name} / #{default_product_quantity.product.name}" %>"
                          data-modal-url-param="<%= default_product_quantity_path(default_product_quantity) %>">
                    <%= t(".delete") %>
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>

  <%= render "shared/confirm_dialog" %>
</div>
