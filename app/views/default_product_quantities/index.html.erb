<% content_for :title, t(".title") %>

<div class="flex w-full flex-col gap-6" data-controller="modal edit-modal">
  <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
    <%= form_with url: default_product_quantities_path, method: :get, class: "flex flex-wrap items-end gap-3",
          data: { controller: "auto-submit client-zone-filter", turbo_frame: "default_product_quantities" } do %>
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-text" for="zone_id"><%= t("shared.filters.zone_label") %></label>
        <select name="zone_id" id="zone_id" data-action="change->client-zone-filter#reload change->auto-submit#submit"
                data-auto-submit-clear-param="route_id" class="<%= filter_control_class %>">
          <option value=""><%= t("shared.filters.all_zones") %></option>
          <% @zones.each do |zone| %>
            <option value="<%= zone.id %>" <%= "selected" if zone.id.to_s == @filter_zone_id %>><%= zone.name %></option>
          <% end %>
        </select>
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-text" for="route_id"><%= t("shared.filters.route_label") %></label>
        <%= turbo_frame_tag "default_route_filter", data: { client_zone_filter_target: "frame" } do %>
          <select name="route_id" id="route_id" data-action="change->auto-submit#submit"
                  class="<%= filter_control_class %>">
            <option value=""><%= t("shared.filters.all_routes") %></option>
            <% @filter_routes.each do |route| %>
              <option value="<%= route.id %>" <%= "selected" if route.id.to_s == @filter_route_id %>><%= route.name %></option>
            <% end %>
          </select>
        <% end %>
      </div>
      <%= render "shared/clear_filters", path: default_product_quantities_path %>
    <% end %>

    <%= link_to t(".new_button"), new_default_product_quantity_path, class: create_button_class %>
  </div>

  <%= turbo_frame_tag "default_product_quantities", class: "flex flex-col gap-6", data: { turbo_action: "advance" } do %>
    <div class="overflow-x-auto rounded border border-border bg-surface">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-border text-text-muted">
            <th class="px-4 py-3 font-medium"><%= t(".table_zone") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_route") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_product") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_quantity") %></th>
            <th class="px-4 py-3 font-medium"><%= t(".table_actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @default_product_quantities.empty? %>
            <tr>
              <td class="px-4 py-3 text-text-muted" colspan="5"><%= t(".no_results") %></td>
            </tr>
          <% end %>
          <%= render partial: "default_product_quantities/row", collection: @default_product_quantities,
                     as: :default_product_quantity %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>

  <%= render "shared/confirm_dialog" %>
  <%= render "shared/edit_modal", frame_id: "default_product_quantity_edit_modal" %>
</div>
