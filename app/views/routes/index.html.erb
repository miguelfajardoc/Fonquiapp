<% content_for :title, t(".title") %>

<div class="flex w-full flex-col gap-6" data-controller="modal">
  <div class="mt-4 flex justify-end">
    <%= link_to t(".new_button"), new_route_path, class: create_button_class %>
  </div>

  <div class="overflow-x-auto rounded border border-border bg-surface">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="border-b border-border text-text-muted">
          <th class="px-4 py-3 font-medium"><%= t(".table_zone") %></th>
          <th class="px-4 py-3 font-medium"><%= t(".table_name") %></th>
          <th class="px-4 py-3 font-medium"><%= t(".table_clients") %></th>
          <th class="px-4 py-3 font-medium"><%= t(".table_actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @routes.each do |route| %>
          <% client_names = route.route_stops.map { |stop| stop.client.name }.join(", ") %>
          <tr class="border-b border-border last:border-0">
            <td class="px-4 py-3 text-text"><%= route.zone.name %></td>
            <td class="px-4 py-3 text-text"><%= route.name %></td>
            <td class="max-w-xs truncate px-4 py-3 text-text" title="<%= client_names %>"><%= client_names %></td>
            <td class="px-4 py-3">
              <div class="flex gap-3">
                <%= link_to t(".edit"), edit_route_path(route),
                      class: "rounded border border-border px-3 py-1.5 text-text" %>
                <button type="button"
                        class="rounded border border-border px-3 py-1.5 text-text"
                        data-action="modal#open"
                        data-modal-name-param="<%= route.name %>"
                        data-modal-url-param="<%= route_path(route) %>">
                  <%= t(".delete") %>
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/confirm_dialog" %>
</div>
