<% content_for :title, t(".title") %>

<div class="flex flex-col gap-6">
  <h1 class="text-2xl font-semibold text-text"><%= t(".title") %></h1>

  <%= form_with url: password_change_path, method: :patch, class: "flex flex-col gap-4 max-w-sm" do |form| %>
    <% if @error %>
      <div class="rounded border border-accent bg-surface-2 px-4 py-3 text-sm text-text font-semibold"><%= @error %></div>
    <% end %>

    <div class="flex flex-col gap-1">
      <%= form.label :current_password, t(".current_password_label"), class: "text-sm font-medium text-text" %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password",
            class: filter_control_class %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :password, t(".password_label"), class: "text-sm font-medium text-text" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: filter_control_class %>
    </div>

    <div class="flex flex-col gap-1">
      <%= form.label :password_confirmation, t(".password_confirmation_label"), class: "text-sm font-medium text-text" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: filter_control_class %>
    </div>

    <div class="flex justify-end">
      <%= form.submit t(".submit"),
            class: "h-11 rounded border-0 bg-accent px-5 text-sm font-semibold text-accent-contrast cursor-pointer" %>
    </div>
  <% end %>
</div>
